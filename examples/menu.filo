; A menu: the keys belong to the script, and (goto) is the navigation.
;   hanabi examples/menu.filo
;
; q does nothing here -- the show releases it on purpose, so pressing it by
; accident during a presentation costs nothing. Ctrl-C always aborts; no script
; can take that away.
;
; Leaving is a jump to a label with nothing after it: the show runs out of steps
; and ends, which is all that ending ever was.

(set-key "q"
  (none))
(set-key "x"
  (goto "the end"))
(set-key "1"
  (goto "one"))
(set-key "2"
  (goto "two"))
(set-key "0"
  (goto "menu"))

(label "menu")
(shot "typing" "  1  the invader\n  2  the heart\n  x  leave\n\n  (0 returns here)" 1.6)
(wait-key)
(goto "menu")

(label "one")
(clear)
(shot "matrix,burn"
  (file "art/invader.txt"))
(wait-key)
(clear)
(goto "menu")

(label "two")
(clear)
(shot "expand,colorshift"
  (file "art/heart.txt"))
(wait-key)
(clear)
(shot "wipe" "press x to leave, 0 for the menu")
(wait-key)
(goto "menu")

(label "the end")
