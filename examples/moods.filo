; The script is a program: the sequence is a map over a list, and adding a
; mood is adding a line to the list.
;   hanabi examples/moods.filo

(map
  (fn
    (face)
    (shot "decrypt" face)
    (pause 0.7))
  (list "(⇀‿‿↼)  sleeping" "(≖‿‿≖)  awakening" "(◕‿‿◕)  awake" "(⌐■_■)  cool" "(♥‿‿♥)  friendly" "(#__#)  debugging" "(╯°□°）╯︵ ┻━┻  angry"))

(wait-key)
(shot "scattered"
  (file "art/bunny.txt"))

