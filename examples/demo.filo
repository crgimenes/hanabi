; A hanabi show: each builtin records a step, and the steps play in order.
;   hanabi examples/demo.filo
; During (wait-key) any key advances; q quits, Ctrl-C aborts.

(shot "slide,decrypt" "hanabi\na show, scripted in filo")
(pause 1)

; Loops come from the language itself.
(map (fn (i) (shot "wipe" "tick")) (range 2))

(wait-key)
(clear)
(shot "fireworks,burn" (file "finale.txt"))
